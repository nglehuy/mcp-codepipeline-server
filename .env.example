AWS_REGION=us-east-1

# Recommended for local dev: named profile from ~/.aws/credentials (SSO, assume-role, etc.)
# AWS_PROFILE=your-profile

# Optional: long-lived or temporary keys (omit both to use the default credential chain)
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_SESSION_TOKEN=your_session_token

# Only used by the legacy HTTP server (src/mcp-server.ts), not stdio MCP mode
# PORT=3000
